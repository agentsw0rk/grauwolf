fn code_module(
    name: &'static str,
    bytes: &'static [u8],
) -> grauwolf_agents::code::CodeModule {
    static MODULES: std::sync::OnceLock<
        std::sync::Mutex<
            std::collections::HashMap<&'static str, grauwolf_agents::code::CodeModule>,
        >,
    > = std::sync::OnceLock::new();
    let mut modules = MODULES
        .get_or_init(Default::default)
        .lock()
        .unwrap_or_else(|poisoned| poisoned.into_inner());
    modules
        .entry(name)
        .or_insert_with(|| {
            let runtime = grauwolf_sandbox::SandboxRuntime::new()
                .expect("the sandbox starts");
            let artifact = grauwolf_tools::ToolArtifact {
                name: name.into(),
                bytes: bytes.to_vec(),
                hash: String::new(),
            };
            grauwolf_agents::code::CodeModule::load(&runtime, &artifact)
                .expect("the embedded code module is valid")
        })
        .clone()
}
/// Strategy graph of the agent.
pub fn graph() -> Result<TypedGraph<AgentContext, String, Reply>, GraphError> {
    let module_code_main_score = code_module(
        "code_main_score",
        include_bytes!("../tools/code_main_score.wasm"),
    );
    let module_condition_main_score_finish = code_module(
        "condition_main_score_finish",
        include_bytes!("../tools/condition_main_score_finish.wasm"),
    );
    let module_transform_main_score_finish = code_module(
        "transform_main_score_finish",
        include_bytes!("../tools/transform_main_score_finish.wasm"),
    );
    let module_transform_main_score_finish_2 = code_module(
        "transform_main_score_finish_2",
        include_bytes!("../tools/transform_main_score_finish_2.wasm"),
    );
    TypedGraph::build(|g| {
        let node_judge = g.node("judge", grauwolf_agents::nodes::llm_request);
        let node_score = g
            .node(
                "score",
                grauwolf_agents::code::code_node_typed::<
                    String,
                    Verdict,
                >(module_code_main_score.clone()),
            );
        g.edge(&g.start(), &node_judge);
        g.edge_when(
            &node_judge,
            &node_score,
            grauwolf_agents::conditions::on_assistant_message,
        );
        g.edge_with(
            &node_score,
            &g.finish(),
            Some(
                grauwolf_agents::code::code_condition(
                    module_condition_main_score_finish.clone(),
                ),
            ),
            Some(
                grauwolf_agents::code::code_transform(
                    module_transform_main_score_finish.clone(),
                ),
            ),
        );
        g.edge_with(
            &node_score,
            &g.finish(),
            None,
            Some(
                grauwolf_agents::code::code_transform(
                    module_transform_main_score_finish_2.clone(),
                ),
            ),
        );
    })
}
