//! Generated from the AgentSpec `subgraph_calculator` – do not edit by hand.

use std::sync::Arc;
use grauwolf_agents::AgentContext;
use grauwolf_graph::{GraphError, TypedGraph};
use grauwolf_llm::PromptExecutor;
use grauwolf_prompt::{LlModel, Prompt};
use grauwolf_agents::run_handles::RunHandles;
use grauwolf_agents::events::Feature;
use grauwolf_tools::{ToolRegistry, ToolArtifact, ToolDescriptor, ToolRuntime};
/// Strategy graph of the agent.
pub fn graph() -> Result<TypedGraph<AgentContext, String, String>, GraphError> {
    let sub_solve = subgraph_solve()?;
    TypedGraph::build(|g| {
        let node_solve = g
            .subgraph(
                "solve",
                sub_solve,
                Some(Box::new(grauwolf_agents::scopes::ToolSubset::new(["add"]))),
            );
        g.edge(&g.start(), &node_solve);
        g.edge(&node_solve, &g.finish());
    })
}
/// Subgraph `solve`.
pub fn subgraph_solve() -> Result<TypedGraph<AgentContext, String, String>, GraphError> {
    TypedGraph::build(|g| {
        let node_call_llm = g.node("call_llm", grauwolf_agents::nodes::llm_request);
        let node_execute_tool = g
            .node("execute_tool", grauwolf_agents::nodes::execute_tool);
        let node_send_result = g
            .node("send_result", grauwolf_agents::nodes::llm_send_tool_result);
        let node_execute_tools_in_order = g
            .node(
                "execute_tools_in_order",
                grauwolf_agents::nodes::execute_tools_in_order,
            );
        let node_send_results = g
            .node(
                "send_results",
                grauwolf_agents::nodes::llm_send_multiple_tool_results,
            );
        g.edge(&g.start(), &node_call_llm);
        g.edge_when(
            &node_call_llm,
            &node_execute_tool,
            grauwolf_agents::conditions::on_tool_call,
        );
        g.edge_when(
            &node_call_llm,
            &node_execute_tools_in_order,
            grauwolf_agents::conditions::on_multiple_tool_calls,
        );
        g.edge_when(
            &node_call_llm,
            &g.finish(),
            grauwolf_agents::conditions::on_assistant_message,
        );
        g.edge(&node_execute_tool, &node_send_result);
        g.edge_when(
            &node_send_result,
            &node_execute_tool,
            grauwolf_agents::conditions::on_tool_call,
        );
        g.edge_when(
            &node_send_result,
            &node_execute_tools_in_order,
            grauwolf_agents::conditions::on_multiple_tool_calls,
        );
        g.edge_when(
            &node_send_result,
            &g.finish(),
            grauwolf_agents::conditions::on_assistant_message,
        );
        g.edge(&node_execute_tools_in_order, &node_send_results);
        g.edge_when(
            &node_send_results,
            &node_execute_tool,
            grauwolf_agents::conditions::on_tool_call,
        );
        g.edge_when(
            &node_send_results,
            &node_execute_tools_in_order,
            grauwolf_agents::conditions::on_multiple_tool_calls,
        );
        g.edge_when(
            &node_send_results,
            &g.finish(),
            grauwolf_agents::conditions::on_assistant_message,
        );
    })
}
/// Model from the spec.
pub fn model() -> LlModel {
    LlModel::new("ollama", "llama3.2")
}
/// Initial prompt from the spec.
pub fn prompt() -> Prompt {
    Prompt::builder("subgraph_calculator")
        .system("You are a calculator. Use the tools for every arithmetic operation.")
        .build()
}
/// Runs the agent with `input` in a fresh context.
pub async fn run(
    executor: Arc<PromptExecutor>,
    input: String,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_observed(executor, input, Vec::new()).await
}
/// Like [`run`]; `features` see all events of the run, in the same order as with the interpreter (ADR-0084).
pub async fn run_observed(
    executor: Arc<PromptExecutor>,
    input: String,
    features: Vec<Arc<dyn Feature>>,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_handled(executor, Some(input), features, RunHandles::default()).await
}
/// The core of all entry points: like [`run_observed`], with the handles of the caller – prices, a budget of its own, an approver for tools that need approval, a frame sink, a conversation, attachments and checkpoints; with `handles.resume` the run continues from its checkpoint and `input` is `None` (ADR-0119).
pub async fn run_handled(
    executor: Arc<PromptExecutor>,
    input: Option<String>,
    features: Vec<Arc<dyn Feature>>,
    handles: RunHandles,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    let state = handles.resume_state().await?;
    let mut ctx = handles
        .context(
            executor,
            model(),
            prompt(),
            state.as_ref(),
            grauwolf_agents::Budget::default(),
            &[],
        )?
        .with_tools(tools()?);
    for feature in features {
        ctx = ctx.install(feature);
    }
    let run = handles.start(input.as_ref(), state.as_ref())?;
    let graph = graph()?;
    Ok(RunHandles::run_graph(run, &mut ctx, graph, input, state).await?)
}
/// The spec of this crate as JSON (for `run_app`, ADR-0084).
pub const SPEC_JSON: &str = "{\"spec_version\":1,\"name\":\"subgraph_calculator\",\"model\":{\"provider\":\"ollama\",\"id\":\"llama3.2\"},\"system_prompt\":\"You are a calculator. Use the tools for every arithmetic operation.\",\"types\":{},\"input\":\"string\",\"output\":\"string\",\"tools\":[{\"name\":\"add\",\"description\":\"Adds two numbers\",\"args\":{\"properties\":{\"a\":{\"type\":\"number\"},\"b\":{\"type\":\"number\"}},\"required\":[\"a\",\"b\"],\"type\":\"object\"},\"code\":\"let a = args[\\\"a\\\"].as_f64().ok_or(\\\"a missing\\\")?;\\nlet b = args[\\\"b\\\"].as_f64().ok_or(\\\"b missing\\\")?;\\nOk((a + b).to_string())\"}],\"mcp_servers\":{},\"agent_tools\":{},\"builtin_tools\":null,\"knowledge\":null,\"long_term_memory\":null,\"tools_dir\":null,\"limits\":null,\"self_tools\":null,\"subgraphs\":{\"solve\":{\"input\":\"string\",\"output\":\"string\",\"tools\":[\"add\"],\"self_tools\":null,\"model\":null,\"graph\":{\"nodes\":[{\"id\":\"call_llm\",\"kind\":\"llm_request\",\"params\":null},{\"id\":\"execute_tool\",\"kind\":\"execute_tool\",\"params\":null},{\"id\":\"send_result\",\"kind\":\"llm_send_tool_result\",\"params\":null},{\"id\":\"execute_tools_in_order\",\"kind\":\"execute_multiple_tools\",\"params\":{\"sequential\":true}},{\"id\":\"send_results\",\"kind\":\"llm_send_multiple_tool_results\",\"params\":null}],\"edges\":[{\"from\":\"start\",\"to\":\"call_llm\",\"when\":null},{\"from\":\"call_llm\",\"to\":\"execute_tool\",\"when\":{\"kind\":\"on_tool_call\",\"params\":null}},{\"from\":\"call_llm\",\"to\":\"execute_tools_in_order\",\"when\":{\"kind\":\"on_multiple_tool_calls\",\"params\":null}},{\"from\":\"call_llm\",\"to\":\"finish\",\"when\":{\"kind\":\"on_assistant_message\",\"params\":null}},{\"from\":\"execute_tool\",\"to\":\"send_result\",\"when\":null},{\"from\":\"send_result\",\"to\":\"execute_tool\",\"when\":{\"kind\":\"on_tool_call\",\"params\":null}},{\"from\":\"send_result\",\"to\":\"execute_tools_in_order\",\"when\":{\"kind\":\"on_multiple_tool_calls\",\"params\":null}},{\"from\":\"send_result\",\"to\":\"finish\",\"when\":{\"kind\":\"on_assistant_message\",\"params\":null}},{\"from\":\"execute_tools_in_order\",\"to\":\"send_results\",\"when\":null},{\"from\":\"send_results\",\"to\":\"execute_tool\",\"when\":{\"kind\":\"on_tool_call\",\"params\":null}},{\"from\":\"send_results\",\"to\":\"execute_tools_in_order\",\"when\":{\"kind\":\"on_multiple_tool_calls\",\"params\":null}},{\"from\":\"send_results\",\"to\":\"finish\",\"when\":{\"kind\":\"on_assistant_message\",\"params\":null}}]}}},\"strategy\":null,\"graph\":{\"nodes\":[{\"id\":\"solve\",\"kind\":\"subgraph\",\"params\":{\"subgraph\":\"solve\"}}],\"edges\":[{\"from\":\"start\",\"to\":\"solve\",\"when\":null},{\"from\":\"solve\",\"to\":\"finish\",\"when\":null}]}}";
/// Provisions the agent once: providers, external tools, sub-agents and long-term memory with paths relative to `base_dir`, configuration from `options` (feature `app`, ADR-0114).
#[cfg(feature = "app")]
pub async fn provision(
    base_dir: &std::path::Path,
    options: grauwolf::provisioning::ProvisionOptions,
) -> Result<
    grauwolf::provisioning::ProvisionedAgent,
    Box<dyn std::error::Error + Send + Sync>,
> {
    use grauwolf::spec::AgentSpecExt as _;
    let spec = grauwolf::spec::AgentSpec::from_json(SPEC_JSON)?;
    Ok(grauwolf::provisioning::ProvisionedAgent::new(&spec, base_dir, options).await?)
}
#[cfg(feature = "app")]
async fn run_with_options(
    provisioned: &grauwolf::provisioning::ProvisionedAgent,
    input: Option<String>,
    options: grauwolf::app::RunOptions,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_handled(
            provisioned.executor(),
            input,
            options.features.clone(),
            options.handles(provisioned.prices()),
        )
        .await
}
/// Runs the provisioned agent for `options.user` (the area in long-term memory and the key-value store); `options.features` see all events. The other options bring what a caller of the interpreter has: a budget, a conversation, attachments, an approver, a frame sink and checkpoints (feature `app`, ADR-0119).
#[cfg(feature = "app")]
pub async fn run_provisioned(
    provisioned: &grauwolf::provisioning::ProvisionedAgent,
    input: String,
    options: grauwolf::app::RunOptions,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_with_options(provisioned, Some(input), options).await
}
/// Continues the run `run_id` from its last checkpoint in `store`; work before it is not repeated, and the input is the one of the checkpoint (feature `app`, ADR-0119).
#[cfg(feature = "app")]
pub async fn resume_provisioned(
    provisioned: &grauwolf::provisioning::ProvisionedAgent,
    store: Arc<dyn grauwolf_agents::checkpoints::CheckpointStore>,
    run_id: &str,
    options: grauwolf::app::RunOptions,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_with_options(provisioned, None, options.resuming(store, run_id)).await
}
/// Runs the agent like `grauwolf spec run`: providers from the process environment, external tools, sub-agents and long-term memory (shared area) with paths relative to `base_dir` (feature `app`).
#[cfg(feature = "app")]
pub async fn run_app(
    base_dir: &std::path::Path,
    input: String,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    run_app_with(
            base_dir,
            input,
            grauwolf::provisioning::ProvisionOptions::new(
                Arc::new(grauwolf::config::ProcessEnv),
            ),
            grauwolf::app::RunOptions::default(),
        )
        .await
}
/// Like [`run_app`], with the options of the agent (`provision`) and of the run (`run_provisioned`): provisions the agent and runs it once (feature `app`). A service provisions once and runs many times instead.
#[cfg(feature = "app")]
pub async fn run_app_with(
    base_dir: &std::path::Path,
    input: String,
    provision_options: grauwolf::provisioning::ProvisionOptions,
    options: grauwolf::app::RunOptions,
) -> Result<String, Box<dyn std::error::Error + Send + Sync>> {
    let provisioned = provision(base_dir, provision_options).await?;
    run_provisioned(&provisioned, input, options).await
}
/// Tools of the spec; their code runs in the sandbox.
pub fn tools() -> Result<ToolRegistry, Box<dyn std::error::Error + Send + Sync>> {
    let runtime = grauwolf_sandbox::SandboxRuntime::new()?;
    let registry = ToolRegistry::builder()
        .shared(
            runtime
                .instantiate(
                    &ToolArtifact {
                        name: "add".into(),
                        bytes: include_bytes!("../tools/add.wasm").to_vec(),
                        hash: String::new(),
                    },
                    ToolDescriptor {
                        name: "add".into(),
                        description: "Adds two numbers".into(),
                        parameters: serde_json::from_str(
                            "{\"properties\":{\"a\":{\"type\":\"number\"},\"b\":{\"type\":\"number\"}},\"required\":[\"a\",\"b\"],\"type\":\"object\"}",
                        )?,
                    },
                )?,
        )
        .build();
    Ok(registry)
}
