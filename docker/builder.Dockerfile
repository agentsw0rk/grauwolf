# The builder image (ADR-0096): builds generated agent crates offline and fast.
#
#   docker build -f docker/builder.Dockerfile --build-arg GRAUWOLF_VERSION=0.1.0 \
#     -t grauwolf-builder:0.1.0 .
#
# What it contains:
#   - the Rust toolchain with the target wasm32-unknown-unknown (tool code is compiled to WASM
#     by `grauwolf spec generate`) and the `grauwolf` CLI and the lean `grauwolf-tools` program
#     (ADR-0118) in /usr/local/bin;
#   - the grauwolf sources of exactly this version in /opt/grauwolf (the generated Cargo.toml
#     points to /opt/grauwolf/crates) and the workspace Cargo.lock;
#   - all dependencies vendored in /opt/grauwolf/vendor; $CARGO_HOME/config.toml replaces
#     crates.io with them and sets net.offline, so cargo never needs the network;
#   - a pre-built target directory /opt/grauwolf/target: the dependencies of a generated service
#     crate (the facade with all features) are compiled, only the agent crate is left to build.
#
# `ENV GRAUWOLF_VERSION` is what the first build step of a generated Dockerfile compares with the
# version of the CLI that generated the crate. CI adds the labels `org.opencontainers.image.source`
# and `.revision` (`docker build --label`) and builds this image natively for amd64 and arm64.
#
# AgentWeaver runs, in this image: grauwolf spec generate <spec> --dockerfile --out <dir>, and
# builds <dir> with the generated Dockerfile (FROM this image). The Rust version is pinned; keep
# it in step with docker/cli.Dockerfile and docker/agent.Dockerfile.
FROM rust:1.99-slim-bookworm

ARG GRAUWOLF_VERSION
RUN test -n "$GRAUWOLF_VERSION" || { echo "pass --build-arg GRAUWOLF_VERSION=<version>" >&2; exit 1; }

RUN rustup target add wasm32-unknown-unknown

WORKDIR /opt/grauwolf
COPY . .

# The CLI and grauwolf-tools, built in a throw-away target directory.
RUN CARGO_TARGET_DIR=/tmp/cli-target cargo build --release --locked -p grauwolf-cli -p grauwolf-tools-app \
    && install -m 0755 /tmp/cli-target/release/grauwolf /usr/local/bin/grauwolf \
    && install -m 0755 /tmp/cli-target/release/grauwolf-tools /usr/local/bin/grauwolf-tools \
    && rm -rf /tmp/cli-target \
    && test "$(grauwolf --version)" = "grauwolf $GRAUWOLF_VERSION" \
    && test "$(grauwolf-tools --version)" = "grauwolf-tools $GRAUWOLF_VERSION"

# Vendor every dependency, then drop what the registry download left behind: from here on cargo
# reads only /opt/grauwolf/vendor and never the network.
RUN cargo vendor --locked /opt/grauwolf/vendor > /dev/null \
    && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git" \
    && printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "vendored-sources"' \
        '[source.vendored-sources]' \
        'directory = "/opt/grauwolf/vendor"' \
        '[net]' \
        'offline = true' \
        > "$CARGO_HOME/config.toml"

# Pre-build the dependencies of a generated service with the settings of the generated
# Dockerfile (--full-facade makes the dependency graph the same for every spec), offline.
RUN grauwolf spec generate examples/specs/echo.json --service --full-facade \
        --grauwolf-crates /opt/grauwolf/crates --out /tmp/template --cache /tmp/template-tools \
    && cp /opt/grauwolf/Cargo.lock /tmp/template/Cargo.lock \
    && CARGO_TARGET_DIR=/opt/grauwolf/target cargo build --release --offline --features service \
        --manifest-path /tmp/template/Cargo.toml \
    && CARGO_TARGET_DIR=/opt/grauwolf/target cargo clean --release -p echo \
        --manifest-path /tmp/template/Cargo.toml \
    && rm -rf /tmp/template /tmp/template-tools

ENV GRAUWOLF_VERSION=$GRAUWOLF_VERSION
LABEL org.opencontainers.image.title="grauwolf-builder" \
      org.opencontainers.image.version="$GRAUWOLF_VERSION" \
      org.opencontainers.image.description="Offline builder for agents generated by grauwolf"
