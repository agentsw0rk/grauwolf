{
  "name": "text-and-math",
  "version": "1.0.0",
  "tools": [
    {
      "name": "add",
      "description": "Addiert zwei Zahlen",
      "args": {
        "type": "object",
        "properties": { "a": { "type": "number" }, "b": { "type": "number" } },
        "required": ["a", "b"]
      }
    },
    {
      "name": "count_words",
      "description": "Zählt die Wörter eines Textes",
