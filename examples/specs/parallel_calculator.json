{
  "spec_version": 1,
  "name": "parallel_calculator",
  "model": {
    "provider": "ollama",
    "id": "llama3.2"
  },
  "system_prompt": "You are a calculator. Call the add tool for every addition; call it several times at once when there are several additions.",
  "tools": [
    {
      "name": "add",
      "description": "Adds two numbers",
      "args": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        },
        "required": [
          "a",
          "b"
        ]
      },
      "code": "let a = args[\"a\"].as_f64().ok_or(\"a missing\")?;\nlet b = args[\"b\"].as_f64().ok_or(\"b missing\")?;\nOk((a + b).to_string())"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "call_llm",
        "kind": "llm_request"
      },
      {
        "id": "execute_tools",
        "kind": "execute_multiple_tools"
      },
      {
        "id": "send_results",
        "kind": "llm_send_multiple_tool_results"
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "call_llm"
      },
      {
        "from": "call_llm",
        "to": "execute_tools",
        "when": {
          "kind": "on_multiple_tool_calls"
        }
      },
      {
        "from": "call_llm",
        "to": "finish",
        "when": {
          "kind": "on_assistant_message"
        }
      },
      {
        "from": "execute_tools",
        "to": "send_results"
      },
      {
        "from": "send_results",
        "to": "execute_tools",
        "when": {
          "kind": "on_multiple_tool_calls"
        }
      },
      {
        "from": "send_results",
        "to": "finish",
        "when": {
          "kind": "on_assistant_message"
        }
      }
    ]
  }
}
