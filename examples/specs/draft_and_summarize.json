{
  "spec_version": 1,
  "name": "draft_and_summarize",
  "model": { "provider": "ollama", "id": "llama3.2" },
  "system_prompt": "You write short drafts and summarize them in one sentence.",
  "subgraphs": {
    "draft": {
      "input": "string",
      "output": "string",
      "graph": {
        "nodes": [
          { "id": "write", "kind": "llm_request" }
        ],
        "edges": [
          { "from": "start", "to": "write" },
          { "from": "write", "to": "finish", "when": { "kind": "on_assistant_message" } }
        ]
      }
    }
  },
  "graph": {
    "nodes": [
      { "id": "draft", "kind": "subgraph", "params": { "subgraph": "draft" } },
      { "id": "summarize", "kind": "llm_request" }
    ],
    "edges": [
      { "from": "start", "to": "draft" },
      { "from": "draft", "to": "summarize" },
      { "from": "summarize", "to": "finish", "when": { "kind": "on_assistant_message" } }
    ]
  }
}
