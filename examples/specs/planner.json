{
  "spec_version": 1,
  "name": "planner",
  "model": { "provider": "ollama", "id": "llama3.2" },
  "system_prompt": "Work through tasks thoroughly and step by step.",
  "subgraphs": {
    "step": {
      "graph": {
        "nodes": [ { "id": "call_llm", "kind": "llm_request" } ],
        "edges": [
          { "from": "start", "to": "call_llm" },
          { "from": "call_llm", "to": "finish", "when": { "kind": "on_assistant_message" } }
        ]
      }
    }
  },
  "graph": {
    "nodes": [ { "id": "solve", "kind": "plan", "params": { "subgraph": "step", "critic": true, "max_iterations": 10 } } ],
    "edges": [
      { "from": "start", "to": "solve" },
      { "from": "solve", "to": "finish" }
    ]
  }
}
